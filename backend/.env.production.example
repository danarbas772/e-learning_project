# ==========================================
# E-LEARNING BACKEND - PRODUCTION CONFIG
# Jagoan Hosting (cPanel) - api.webdev.online
# ==========================================

PORT=3000
NODE_ENV=production
JWT_SECRET=GANTI_DENGAN_SECRET_PANJANG_DAN_ACAK_MIN_32_KARAKTER

# CORS - Izinkan frontend
FRONTEND_URL=https://e-learning.webdev.online

# Database (dari cPanel → MySQL Databases)
# Format: namauser_namadb
DB_HOST=localhost
DB_PORT=3306
DB_USER=CPANEL_USERNAME_db
DB_PASSWORD=PASSWORD_DB_ANDA

# Nama database (dari cPanel → MySQL Databases)
# Pada cPanel: nama selalu diawali username cPanel, contoh: basdev_elearning
DB_NAME_AUTH=CPANEL_USERNAME_elearning
DB_NAME_USER=CPANEL_USERNAME_elearning
DB_NAME_COURSE=CPANEL_USERNAME_elearning
DB_NAME_ENROLLMENT=CPANEL_USERNAME_elearning
DB_NAME_QUIZ=CPANEL_USERNAME_elearning

# Upload Configuration
UPLOAD_DIR=services/course-service/uploads
MAX_FILE_SIZE=52428800
