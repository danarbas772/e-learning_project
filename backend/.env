# ==========================================
# E-LEARNING BACKEND CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development
JWT_SECRET=elearning_secret_key_2024
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Multi-Database Configuration (Default Local Development)
DB_NAME_AUTH=elearning_auth
DB_NAME_USER=elearning_users
DB_NAME_COURSE=elearning_courses
DB_NAME_ENROLLMENT=elearning_enrollments
DB_NAME_QUIZ=elearning_quizzes

# Single-Database Configuration (Gunakan baris di bawah ini jika di cPanel/Hosting semua tabel dalam 1 database)
# DB_NAME=nama_database_cpanel

# File Upload Configuration
UPLOAD_DIR=services/course-service/uploads
MAX_FILE_SIZE=52428800
